{
  "openapi": "3.1.0",
  "info": {
    "title": "ExoScope",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/turn": {
      "post": {
        "summary": "Turn",
        "operationId": "turn_turn_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TurnRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TurnResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AudioInput": {
        "properties": {
          "data_base64": {
            "type": "string",
            "title": "Data Base64"
          },
          "mime_type": {
            "type": "string",
            "title": "Mime Type"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["data_base64", "mime_type"],
        "title": "AudioInput"
      },
      "Axis": {
        "properties": {
          "property": {
            "type": "string",
            "enum": [
              "orbital_period",
              "semi_major_axis",
              "radius",
              "mass",
              "insolation",
              "equilibrium_temperature",
              "eccentricity"
            ],
            "title": "Property"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "unit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit"
          }
        },
        "type": "object",
        "required": ["property", "label", "unit"],
        "title": "Axis"
      },
      "Comparison": {
        "properties": {
          "x": {
            "$ref": "#/components/schemas/Axis"
          },
          "y": {
            "$ref": "#/components/schemas/Axis"
          },
          "rows": {
            "items": {
              "$ref": "#/components/schemas/ComparisonRow"
            },
            "type": "array",
            "title": "Rows"
          },
          "provenance": {
            "items": {
              "$ref": "#/components/schemas/SystemProvenance"
            },
            "type": "array",
            "title": "Provenance",
            "description": "Where each System's values came from"
          },
          "notes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Notes"
          }
        },
        "type": "object",
        "required": ["x", "y", "rows", "provenance", "notes"],
        "title": "Comparison"
      },
      "ComparisonRow": {
        "properties": {
          "planet": {
            "type": "string",
            "title": "Planet",
            "description": "Canonical archive pl_name; links chart, table and scene"
          },
          "hostname": {
            "type": "string",
            "title": "Hostname"
          },
          "x": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Measured"
              },
              {
                "$ref": "#/components/schemas/Missing"
              }
            ],
            "title": "X",
            "discriminator": {
              "propertyName": "status",
              "mapping": {
                "measured": "#/components/schemas/Measured",
                "missing": "#/components/schemas/Missing"
              }
            }
          },
          "y": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Measured"
              },
              {
                "$ref": "#/components/schemas/Missing"
              }
            ],
            "title": "Y",
            "discriminator": {
              "propertyName": "status",
              "mapping": {
                "measured": "#/components/schemas/Measured",
                "missing": "#/components/schemas/Missing"
              }
            }
          },
          "excluded": {
            "anyOf": [
              {
                "type": "string",
                "enum": ["missing_x", "missing_y", "missing_both", "limit_only"]
              },
              {
                "type": "null"
              }
            ],
            "title": "Excluded",
            "description": "Why the planet is not plotted; None when it is plotted"
          }
        },
        "type": "object",
        "required": ["planet", "hostname", "x", "y", "excluded"],
        "title": "ComparisonRow"
      },
      "Exclusion": {
        "properties": {
          "count": {
            "type": "integer",
            "title": "Count"
          },
          "by_field": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "By Field",
            "description": "Excluded planets missing each field"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          }
        },
        "type": "object",
        "required": ["count", "by_field", "reason"],
        "title": "Exclusion",
        "description": "Planets that pass every known condition but lack a value the search depends on."
      },
      "Filter": {
        "properties": {
          "field": {
            "type": "string",
            "title": "Field",
            "description": "Allowlisted field name, e.g. radius or orbital_period"
          },
          "op": {
            "type": "string",
            "title": "Op",
            "description": "One of < <= > >= = between is_null"
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value",
            "description": "Number to compare with (lower bound for between); text for ="
          },
          "upper": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Upper",
            "description": "Upper bound, only for between"
          }
        },
        "type": "object",
        "required": ["field", "op"],
        "title": "Filter",
        "description": "One explicit condition on an allowlisted field."
      },
      "FocusPlanet": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "focus_planet",
            "title": "Kind",
            "default": "focus_planet"
          },
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Archive pl_name, e.g. 'TRAPPIST-1 e'."
          }
        },
        "type": "object",
        "required": ["name"],
        "title": "FocusPlanet"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": ["status"],
        "title": "Health"
      },
      "Interpretation": {
        "properties": {
          "term": {
            "type": "string",
            "title": "Term",
            "description": "The student's word, e.g. small"
          },
          "as": {
            "type": "string",
            "title": "As",
            "description": "How it was read, e.g. radius < 2 Earth radii"
          },
          "caveat": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Caveat",
            "description": "Required for loaded words such as Earth-like or habitable"
          }
        },
        "type": "object",
        "required": ["term", "as"],
        "title": "Interpretation",
        "description": "How a vague word in the student's request was read as a concrete filter."
      },
      "LiveProvenance": {
        "properties": {
          "mode": {
            "type": "string",
            "const": "live",
            "title": "Mode",
            "default": "live"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "fetched_at": {
            "type": "string",
            "format": "date-time",
            "title": "Fetched At"
          }
        },
        "type": "object",
        "required": ["source", "fetched_at"],
        "title": "LiveProvenance"
      },
      "LoadSystem": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "load_system",
            "title": "Kind",
            "default": "load_system"
          },
          "system": {
            "$ref": "#/components/schemas/System"
          }
        },
        "type": "object",
        "required": ["system"],
        "title": "LoadSystem"
      },
      "Measured": {
        "properties": {
          "status": {
            "type": "string",
            "const": "measured",
            "title": "Status",
            "default": "measured"
          },
          "value": {
            "type": "number",
            "title": "Value"
          },
          "unit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit"
          },
          "err_lo": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Err Lo",
            "description": "Size of the lower uncertainty (positive)"
          },
          "err_hi": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Err Hi",
            "description": "Size of the upper uncertainty (positive)"
          },
          "limit": {
            "anyOf": [
              {
                "type": "string",
                "enum": ["upper", "lower"]
              },
              {
                "type": "null"
              }
            ],
            "title": "Limit",
            "description": "Set when the value is a limit rather than a measurement"
          },
          "reference": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Reference"
              },
              {
                "type": "null"
              }
            ]
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          }
        },
        "type": "object",
        "required": ["value", "unit", "err_lo", "err_hi", "limit", "reference"],
        "title": "Measured"
      },
      "Missing": {
        "properties": {
          "status": {
            "type": "string",
            "const": "missing",
            "title": "Status",
            "default": "missing"
          },
          "unit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit"
          }
        },
        "type": "object",
        "required": ["unit"],
        "title": "Missing"
      },
      "Planet": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Canonical archive pl_name; the planet's ID"
          },
          "letter": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Letter"
          },
          "orbital_period": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Measured"
              },
              {
                "$ref": "#/components/schemas/Missing"
              }
            ],
            "title": "Orbital Period",
            "discriminator": {
              "propertyName": "status",
              "mapping": {
                "measured": "#/components/schemas/Measured",
                "missing": "#/components/schemas/Missing"
              }
            }
          },
          "semi_major_axis": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Measured"
              },
              {
                "$ref": "#/components/schemas/Missing"
              }
            ],
            "title": "Semi Major Axis",
            "discriminator": {
              "propertyName": "status",
              "mapping": {
                "measured": "#/components/schemas/Measured",
                "missing": "#/components/schemas/Missing"
              }
            }
          },
          "radius": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Measured"
              },
              {
                "$ref": "#/components/schemas/Missing"
              }
            ],
            "title": "Radius",
            "discriminator": {
              "propertyName": "status",
              "mapping": {
                "measured": "#/components/schemas/Measured",
                "missing": "#/components/schemas/Missing"
              }
            }
          },
          "mass": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Measured"
              },
              {
                "$ref": "#/components/schemas/Missing"
              }
            ],
            "title": "Mass",
            "discriminator": {
              "propertyName": "status",
              "mapping": {
                "measured": "#/components/schemas/Measured",
                "missing": "#/components/schemas/Missing"
              }
            }
          },
          "mass_provenance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mass Provenance",
            "description": "Archive pl_bmassprov, e.g. Mass or Msini"
          },
          "insolation": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Measured"
              },
              {
                "$ref": "#/components/schemas/Missing"
              }
            ],
            "title": "Insolation",
            "discriminator": {
              "propertyName": "status",
              "mapping": {
                "measured": "#/components/schemas/Measured",
                "missing": "#/components/schemas/Missing"
              }
            }
          },
          "equilibrium_temperature": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Measured"
              },
              {
                "$ref": "#/components/schemas/Missing"
              }
            ],
            "title": "Equilibrium Temperature",
            "discriminator": {
              "propertyName": "status",
              "mapping": {
                "measured": "#/components/schemas/Measured",
                "missing": "#/components/schemas/Missing"
              }
            }
          },
          "eccentricity": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Measured"
              },
              {
                "$ref": "#/components/schemas/Missing"
              }
            ],
            "title": "Eccentricity",
            "discriminator": {
              "propertyName": "status",
              "mapping": {
                "measured": "#/components/schemas/Measured",
                "missing": "#/components/schemas/Missing"
              }
            }
          },
          "inclination": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Measured"
              },
              {
                "$ref": "#/components/schemas/Missing"
              }
            ],
            "title": "Inclination",
            "discriminator": {
              "propertyName": "status",
              "mapping": {
                "measured": "#/components/schemas/Measured",
                "missing": "#/components/schemas/Missing"
              }
            }
          },
          "transit_midpoint": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Measured"
              },
              {
                "$ref": "#/components/schemas/Missing"
              }
            ],
            "title": "Transit Midpoint",
            "discriminator": {
              "propertyName": "status",
              "mapping": {
                "measured": "#/components/schemas/Measured",
                "missing": "#/components/schemas/Missing"
              }
            }
          },
          "argument_of_periastron": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Measured"
              },
              {
                "$ref": "#/components/schemas/Missing"
              }
            ],
            "title": "Argument Of Periastron",
            "discriminator": {
              "propertyName": "status",
              "mapping": {
                "measured": "#/components/schemas/Measured",
                "missing": "#/components/schemas/Missing"
              }
            }
          }
        },
        "type": "object",
        "required": [
          "name",
          "letter",
          "orbital_period",
          "semi_major_axis",
          "radius",
          "mass",
          "mass_provenance",
          "insolation",
          "equilibrium_temperature",
          "eccentricity",
          "inclination",
          "transit_midpoint",
          "argument_of_periastron"
        ],
        "title": "Planet"
      },
      "Reference": {
        "properties": {
          "label": {
            "type": "string",
            "title": "Label"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          }
        },
        "type": "object",
        "required": ["label", "url"],
        "title": "Reference",
        "description": "The publication a catalog value comes from."
      },
      "ReplyAudio": {
        "properties": {
          "data_base64": {
            "type": "string",
            "title": "Data Base64"
          },
          "mime_type": {
            "type": "string",
            "title": "Mime Type"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["data_base64", "mime_type"],
        "title": "ReplyAudio"
      },
      "Sample": {
        "properties": {
          "filters": {
            "items": {
              "$ref": "#/components/schemas/Filter"
            },
            "type": "array",
            "title": "Filters"
          },
          "interpretations": {
            "items": {
              "$ref": "#/components/schemas/Interpretation"
            },
            "type": "array",
            "title": "Interpretations"
          },
          "sort": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Sort"
              },
              {
                "type": "null"
              }
            ]
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "fields": {
            "items": {
              "$ref": "#/components/schemas/SampleField"
            },
            "type": "array",
            "title": "Fields"
          },
          "planets": {
            "items": {
              "$ref": "#/components/schemas/SamplePlanet"
            },
            "type": "array",
            "title": "Planets"
          },
          "matched": {
            "type": "integer",
            "title": "Matched",
            "description": "All planets matching the filters, before the limit"
          },
          "truncated": {
            "type": "boolean",
            "title": "Truncated"
          },
          "excluded": {
            "$ref": "#/components/schemas/Exclusion"
          },
          "provenance": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/LiveProvenance"
              },
              {
                "$ref": "#/components/schemas/SnapshotProvenance"
              }
            ],
            "title": "Provenance",
            "discriminator": {
              "propertyName": "mode",
              "mapping": {
                "live": "#/components/schemas/LiveProvenance",
                "snapshot": "#/components/schemas/SnapshotProvenance"
              }
            }
          },
          "notes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Notes"
          }
        },
        "type": "object",
        "required": [
          "filters",
          "interpretations",
          "sort",
          "limit",
          "fields",
          "planets",
          "matched",
          "truncated",
          "excluded",
          "provenance",
          "notes"
        ],
        "title": "Sample",
        "description": "A set of planets selected by explicit, visible filters. Missing is never treated as zero."
      },
      "SampleField": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "unit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit"
          }
        },
        "type": "object",
        "required": ["name", "label", "unit"],
        "title": "SampleField"
      },
      "SamplePlanet": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Canonical archive pl_name; the planet's ID"
          },
          "hostname": {
            "type": "string",
            "title": "Hostname",
            "description": "Canonical archive hostname of its System"
          },
          "values": {
            "additionalProperties": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/Measured"
                },
                {
                  "$ref": "#/components/schemas/Missing"
                },
                {
                  "$ref": "#/components/schemas/TextValue"
                }
              ],
              "discriminator": {
                "propertyName": "status",
                "mapping": {
                  "measured": "#/components/schemas/Measured",
                  "missing": "#/components/schemas/Missing",
                  "text": "#/components/schemas/TextValue"
                }
              }
            },
            "type": "object",
            "title": "Values"
          }
        },
        "type": "object",
        "required": ["name", "hostname", "values"],
        "title": "SamplePlanet"
      },
      "SetColorBy": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "set_color_by",
            "title": "Kind",
            "default": "set_color_by"
          },
          "property": {
            "type": "string",
            "enum": ["none", "insolation", "radius", "equilibrium_temperature"],
            "title": "Property"
          }
        },
        "type": "object",
        "required": ["property"],
        "title": "SetColorBy",
        "description": "Colour planets by one archive property, with a legend; \"none\" restores fixed colours."
      },
      "SetLabels": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "set_labels",
            "title": "Kind",
            "default": "set_labels"
          },
          "visible": {
            "type": "boolean",
            "title": "Visible"
          }
        },
        "type": "object",
        "required": ["visible"],
        "title": "SetLabels"
      },
      "SetTimeScale": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "set_time_scale",
            "title": "Kind",
            "default": "set_time_scale"
          },
          "days_per_second": {
            "type": "number",
            "maximum": 1000.0,
            "minimum": 0.0,
            "title": "Days Per Second"
          }
        },
        "type": "object",
        "required": ["days_per_second"],
        "title": "SetTimeScale",
        "description": "Simulated days per real second; 0 pauses time."
      },
      "SnapshotProvenance": {
        "properties": {
          "mode": {
            "type": "string",
            "const": "snapshot",
            "title": "Mode",
            "default": "snapshot"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "snapshot_date": {
            "type": "string",
            "format": "date",
            "title": "Snapshot Date"
          }
        },
        "type": "object",
        "required": ["source", "snapshot_date"],
        "title": "SnapshotProvenance"
      },
      "Sort": {
        "properties": {
          "field": {
            "type": "string",
            "title": "Field"
          },
          "direction": {
            "type": "string",
            "enum": ["asc", "desc"],
            "title": "Direction",
            "default": "asc"
