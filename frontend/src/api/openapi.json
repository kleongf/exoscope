{
  "openapi": "3.1.0",
  "info": {
    "title": "ExoScope",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/turn": {
      "post": {
        "summary": "Turn",
        "operationId": "turn_turn_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TurnRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TurnResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "FocusPlanet": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "focus_planet",
            "title": "Kind",
            "default": "focus_planet"
          },
          "planet_id": {
            "type": "string",
            "title": "Planet Id",
            "description": "Archive pl_name, e.g. 'TRAPPIST-1 e'."
          }
        },
        "type": "object",
        "required": ["planet_id"],
        "title": "FocusPlanet"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": ["status"],
        "title": "Health"
      },
      "SetTimeScale": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "set_time_scale",
            "title": "Kind",
            "default": "set_time_scale"
          },
          "days_per_second": {
            "type": "number",
            "maximum": 1000.0,
            "minimum": 0.0,
            "title": "Days Per Second"
          }
        },
        "type": "object",
        "required": ["days_per_second"],
        "title": "SetTimeScale"
      },
      "TurnRequest": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Text"
          }
        },
        "type": "object",
        "required": ["text"],
        "title": "TurnRequest"
      },
      "TurnResponse": {
        "properties": {
          "transcript": {
            "type": "string",
            "title": "Transcript"
          },
          "reply_text": {
            "type": "string",
            "title": "Reply Text"
          },
          "ui_commands": {
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/FocusPlanet"
                },
                {
                  "$ref": "#/components/schemas/SetTimeScale"
                }
              ],
              "discriminator": {
                "propertyName": "kind",
                "mapping": {
                  "focus_planet": "#/components/schemas/FocusPlanet",
                  "set_time_scale": "#/components/schemas/SetTimeScale"
                }
              }
            },
            "type": "array",
            "title": "Ui Commands"
          }
        },
        "type": "object",
        "required": ["transcript", "reply_text", "ui_commands"],
        "title": "TurnResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": ["loc", "msg", "type"],
        "title": "ValidationError"
      }
    }
  }
}
